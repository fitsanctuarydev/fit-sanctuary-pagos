# ========================================
# MERCADO PAGO (OBLIGATORIO)
# ========================================
# Obtén estos valores en: https://www.mercadopago.com.mx/developers/panel/applications
# Test: comienzan con TEST-
# Live: comienzan con APP_USR-

MP_ACCESS_TOKEN=TEST-tu_token_de_acceso_aqui
VITE_MP_PUBLIC_KEY=TEST-tu_clave_publica_aqui

# ========================================
# STRIPE (OPCIONAL)
# ========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# PAYPAL (OPCIONAL)
# ========================================
PAYPAL_CLIENT_ID=tu_cliente_id_aqui
PAYPAL_CLIENT_SECRET=tu_secreto_aqui
VITE_PAYPAL_CLIENT_ID=tu_cliente_id_aqui

# ========================================
# NODEMAILER / SMTP (PARA CONFIRMACIÓN DE PAGOS)
# ========================================
# Si usas Gmail: crea una "Contraseña de Aplicación"
# Más info: https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_de_app

# ========================================
# URLS (IMPORTANTE PARA WEBHOOKS)
# ========================================
# En desarrollo:
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# En producción (Render):
# BACKEND_URL=https://tu-proyecto-api.onrender.com
# FRONTEND_URL=https://tu-proyecto.onrender.com

# ========================================
# ENTORNO
# ========================================
NODE_ENV=development
